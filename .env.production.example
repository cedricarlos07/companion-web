# =============================================
# COMPANION — Variables de production
# Copiez ce fichier en .env.production et remplissez les valeurs
# Génère les secrets avec : openssl rand -hex 16 (ou 32)
# =============================================

POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=

# Activepieces (optionnel pour le pilot)
ACTIVEPIECES_ENABLED=false
ACTIVEPIECES_URL=http://localhost:5678
ACTIVEPIECES_MCP_TOKEN=

# Ollama (local sur le serveur)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# Licence (optionnel)
LICENSE_PUBLIC_KEY=
